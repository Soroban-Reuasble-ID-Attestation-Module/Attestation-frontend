[TEMPLATE]
# Attestation Frontend — environment overrides (all optional).
#
# Everything has a sane testnet default in src/config/index.ts, which reads
# deployments/testnet.json. Set these only to override for another network.
#
# Only VITE_* variables reach the browser bundle — never put a secret here.

# Public RPC endpoint for Soroban contract calls.
# VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Public Horizon endpoint for account existence + balances.
# VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase for signing.
# VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Optional base URL of the Attestation backend REST API
# (Attestation-backend-sdk `services/api`, default port 8080).
#
# When set, read-only queries (verify, get_attestation) are served by the
# backend and automatically fall back to reading the contract directly if it
# is unreachable. Leave unset to always read the contract from the browser.
#
# The backend must point at the same attestation contract as
# src/config/deployments/testnet.json (ATTESTATION_CONTRACT_ID), and its read
# routes must stay public (PUBLIC_READS=true, the default) — this app does not
# ship API keys to the browser.
# VITE_API_BASE_URL=http://localhost:8080
